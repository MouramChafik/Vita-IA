# Copie ce fichier en .env.local et remplis les valeurs.
# Toutes ces variables sont lues côté serveur uniquement (Route Handlers, scripts).
# Aucune n'a le préfixe NEXT_PUBLIC_ : Next.js recopierait sa valeur dans le code envoyé au navigateur.

GEMINI_API_KEY=

# Supabase : Project Settings > Data API (URL) et API Keys (clé secrète)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe administrateur
ADMIN_PASSWORD=
